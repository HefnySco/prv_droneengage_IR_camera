{
    // A name and GUID for this module
    "module_id": "IR_CAMERA",
    "s2s_udp_target_ip": "127.0.0.1",
    "s2s_udp_target_port": "60000",
    "s2s_udp_listening_ip": "127.0.0.1",
    "s2s_udp_listening_port": "60054",
    "s2s_udp_packet_size": "8192",


    "camera": {
        // Specific Module Parameters
        "source_video_device": "/dev/video0",
        //"output_video_device": "/dev/video5",
        //"source_video_device_name": "SIM-CAM1",
        "source_ir_port": "/dev/ttyACM0",
        "output_video_device_name": "DE-TRK",
        //"overlay_target": "DE-THERMAL",   // explicit CAMERA_OVERLAY_ACTION t override; empty = cam_id, then device names
        "desired_input_width": 1024,
        "desired_input_height": 768,
        "no_display": false
    },

    "dual_camera": {
        "enabled": true,
        "display": true,  // Show live window display
        "display_mode": 3,  // 1=separate, 2=side-by-side, 3=overlay, 4=pip
        "calibration": {
            "scale_x": 1.0,
            "scale_y": 1.0,
            "offset_x": 0,
            "offset_y": 0,
            "rotation": 0.0,
            "alpha": 0.5
        }},

    // Camera the observations come from (obs cam_id); boxes are in the upright
    // thermal image (sensor image rotated 90 deg clockwise), top-left, 0..1
    "cam_id": "DE-THERMAL",

    // Startup state of hotspot detection (obs 6546). Absent = true. Runtime control: 6528 a=4 enable, 2 stop, 3 pause
    "detection_enabled": true,

    // Hotspot detection on the temperature matrix
    "hotspot": {
        "min_delta_c": 8.0,       // contrast above the frame median (below it for coldspots)
        "min_temp_c": -50.0,      // absolute floor for hotspots, e.g. 28 to ignore anything below skin temperature
        "min_area_px": 2,         // smallest blob in sensor pixels
        "max_spots": 5,           // strongest blobs reported per class
        "coldspot_enabled": false // also report "coldspot"
    },

    // Single temporal filter: a spot is published only once it is a confirmed track
    "track": {
        "confirm_hits": 3,
        "max_misses": 5,
        "iou_min": 0.3,
        "min_conf": 0.25
    },

    "tracking": {
        "camera_orientation": 0,        // 0b0000 bit:0 horizontal/vertical, bits1,2: rotation (0,90,180,270)
        "camera_flipped": false,
        "tracking_camera_direction": 1,  // none, front , back , down , up 
        // when true the hot/cold markers are sent to de_camera to draw them
        // using its internal overlay library instead of drawing them locally
        "de_camera_draw": true
    },
    // Advanced Parameters:
    "advanced_tracking": {
        "frames_to_skip_between_messages": 3, //optional default: 15
        "frame_to_skip_between_track_process": 2, //optional default: 5
        "temporal_averaging_enabled": false,
        "temporal_smooth_frames": 3
    }
}